user default on #__DEFAULT_HASH__ ~* &* +@all
user rc-viewer on #__VIEWER_HASH__ resetkeys ~* resetchannels &* -@all +@read +@connection -@dangerous -keys +info +slowlog|get +memory|usage +command|docs +command|info +command|count +command|list +pubsub|channels +pubsub|numsub +pubsub|numpat +subscribe +psubscribe +unsubscribe +punsubscribe +ssubscribe +sunsubscribe +ping +graph.ro_query +graph.explain +graph.list +graph.info|objectpool +graph.memory|usage
