user default on #__DEFAULT_HASH__ ~* &* +@all
user rc-viewer on #__VIEWER_HASH__ resetkeys ~* resetchannels &* -@all +@read +@connection -@dangerous -keys +info +slowlog|get +memory|usage +command|docs +command|info +command|count +command|list +pubsub|channels +pubsub|numsub +pubsub|numpat +subscribe +psubscribe +unsubscribe +punsubscribe +ssubscribe +sunsubscribe +ping +ft._list +ft.info
user rc-operator on #__OPERATOR_HASH__ resetkeys ~* resetchannels &* -@all +@read +@write +@pubsub +@connection +@transaction -@dangerous -@scripting -keys +info +slowlog|get +memory|usage +command|docs +command|info +command|count +command|list +ping +ft._list +ft.info
user rc-admin on #__ADMIN_HASH__ resetkeys ~* resetchannels &* +@all -@scripting -module -keys -debug -shutdown -replicaof -slaveof -failover -migrate -sync -psync -flushall -save -bgrewriteaof -acl|setuser -acl|deluser -acl|save -acl|load -acl|dryrun -config|set -config|rewrite -config|resetstat -cluster|reset -cluster|failover
